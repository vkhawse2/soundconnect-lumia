<Page
    x:Class="SoundConnect.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#FF000000">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,12,16,8">
            <Image Source="Assets/AppLogo.png" Width="48" Height="48" VerticalAlignment="Center"/>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Sound Connect" FontSize="26" FontWeight="SemiBold" Foreground="White"/>
                <TextBlock x:Name="StatusText" Text="Not connected" FontSize="13" Foreground="#FF9E9E9E"/>
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="16,4,16,24">

                <!-- Connect -->
                <TextBlock Text="HEADPHONES" FontSize="13" Foreground="#FF5B8CFF" Margin="0,8,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="DeviceCombo" Grid.Column="0" HorizontalAlignment="Stretch"
                              PlaceholderText="Pick paired headphones"/>
                    <Button x:Name="RefreshDevicesBtn" Grid.Column="1" Content="&#xE72C;"
                            FontFamily="Segoe MDL2 Assets" Margin="8,0,0,0" Click="RefreshDevicesBtn_Click"/>
                </Grid>
                <Button x:Name="ConnectBtn" Content="Connect" HorizontalAlignment="Stretch"
                        Margin="0,10,0,0" Click="ConnectBtn_Click"/>
                <TextBlock Text="Pair the headphones in phone Settings first, and close Sound Connect on any other device - the headphones allow only one controller at a time."
                           FontSize="12" Foreground="#FF9E9E9E" TextWrapping="Wrap" Margin="0,6,0,0"/>

                <StackPanel x:Name="ControlsPanel" IsEnabled="False">
                    <!-- Status -->
                    <TextBlock Text="STATUS" FontSize="13" Foreground="#FF5B8CFF" Margin="0,22,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="BatteryText" Text="Battery: --" FontSize="22" Foreground="White"/>
                        <TextBlock x:Name="ChargingText" Text="" FontSize="14" Foreground="#FF7ED37E"
                                   VerticalAlignment="Bottom" Margin="8,0,0,3"/>
                    </StackPanel>
                    <TextBlock x:Name="CodecText" Text="Codec: --" FontSize="13" Foreground="#FFD6D6D6" Margin="0,2,0,0"/>
                    <TextBlock x:Name="FirmwareText" Text="Firmware: --" FontSize="13" Foreground="#FFD6D6D6"/>
                    <Button x:Name="RefreshBtn" Content="Refresh all" Margin="0,8,0,0" Click="RefreshBtn_Click"/>

                    <!-- Noise control -->
                    <TextBlock Text="NOISE CONTROL" FontSize="13" Foreground="#FF5B8CFF" Margin="0,22,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="NcBtn" Grid.Column="0" Content="Noise Canc." HorizontalAlignment="Stretch" Click="NcBtn_Click"/>
                        <Button x:Name="AmbientBtn" Grid.Column="1" Content="Ambient" HorizontalAlignment="Stretch" Margin="6,0,0,0" Click="AmbientBtn_Click"/>
                        <Button x:Name="OffBtn" Grid.Column="2" Content="Off" HorizontalAlignment="Stretch" Margin="6,0,0,0" Click="OffBtn_Click"/>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Ambient level" Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock x:Name="AmbientValueText" Grid.Column="1" Text="--" Foreground="#FFD6D6D6"/>
                    </Grid>
                    <Slider x:Name="AmbientSlider" Minimum="1" Maximum="20" StepFrequency="1"
                            ValueChanged="AmbientSlider_ValueChanged"/>
                    <ToggleSwitch x:Name="FocusToggle" Header="Focus on Voice" Foreground="White"
                                  Toggled="FocusToggle_Toggled"/>

                    <!-- Equalizer -->
                    <TextBlock Text="EQUALIZER" FontSize="13" Foreground="#FF5B8CFF" Margin="0,22,0,6"/>
                    <ComboBox x:Name="EqPresetCombo" HorizontalAlignment="Stretch"
                              PlaceholderText="Preset" SelectionChanged="EqPresetCombo_SelectionChanged"/>
                    <TextBlock Text="Custom (choosing values + Apply makes a Manual preset)"
                               FontSize="12" Foreground="#FF9E9E9E" Margin="0,10,0,0"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Clear Bass" Foreground="White" VerticalAlignment="Center"/>
                        <Slider x:Name="ClearBassSlider" Grid.Column="1" Minimum="-10" Maximum="10" StepFrequency="1"
                                ValueChanged="EqSlider_ValueChanged"/>
                        <TextBlock x:Name="ClearBassValue" Grid.Column="2" Text="0" Foreground="White" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="400 Hz" Foreground="White" VerticalAlignment="Center"/>
                        <Slider x:Name="Band0Slider" Grid.Column="1" Minimum="-10" Maximum="10" StepFrequency="1" ValueChanged="EqSlider_ValueChanged"/>
                        <TextBlock x:Name="Band0Value" Grid.Column="2" Text="0" Foreground="White" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="1 kHz" Foreground="White" VerticalAlignment="Center"/>
                        <Slider x:Name="Band1Slider" Grid.Column="1" Minimum="-10" Maximum="10" StepFrequency="1" ValueChanged="EqSlider_ValueChanged"/>
                        <TextBlock x:Name="Band1Value" Grid.Column="2" Text="0" Foreground="White" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="2.5 kHz" Foreground="White" VerticalAlignment="Center"/>
                        <Slider x:Name="Band2Slider" Grid.Column="1" Minimum="-10" Maximum="10" StepFrequency="1" ValueChanged="EqSlider_ValueChanged"/>
                        <TextBlock x:Name="Band2Value" Grid.Column="2" Text="0" Foreground="White" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="6.3 kHz" Foreground="White" VerticalAlignment="Center"/>
                        <Slider x:Name="Band3Slider" Grid.Column="1" Minimum="-10" Maximum="10" StepFrequency="1" ValueChanged="EqSlider_ValueChanged"/>
                        <TextBlock x:Name="Band3Value" Grid.Column="2" Text="0" Foreground="White" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="16 kHz" Foreground="White" VerticalAlignment="Center"/>
                        <Slider x:Name="Band4Slider" Grid.Column="1" Minimum="-10" Maximum="10" StepFrequency="1" ValueChanged="EqSlider_ValueChanged"/>
                        <TextBlock x:Name="Band4Value" Grid.Column="2" Text="0" Foreground="White" VerticalAlignment="Center"/>
                    </Grid>
                    <Button x:Name="ApplyEqBtn" Content="Apply custom EQ" HorizontalAlignment="Stretch"
                            Margin="0,8,0,0" Click="ApplyEqBtn_Click"/>

                    <!-- Sound -->
                    <TextBlock Text="SOUND" FontSize="13" Foreground="#FF5B8CFF" Margin="0,22,0,6"/>
                    <ToggleSwitch x:Name="DseeToggle" Header="DSEE (sound upscaling)" Foreground="White"
                                  Toggled="DseeToggle_Toggled"/>
                    <ToggleSwitch x:Name="SpeakToggle" Header="Speak-to-Chat" Foreground="White"
                                  Toggled="SpeakToggle_Toggled"/>

                    <!-- Power -->
                    <TextBlock Text="POWER" FontSize="13" Foreground="#FF5B8CFF" Margin="0,22,0,6"/>
                    <TextBlock Text="Auto power off" Foreground="White"/>
                    <ComboBox x:Name="AutoPowerCombo" HorizontalAlignment="Stretch" Margin="0,4,0,0"
                              SelectionChanged="AutoPowerCombo_SelectionChanged">
                        <ComboBoxItem Content="Do not turn off"/>
                        <ComboBoxItem Content="When taken off"/>
                    </ComboBox>
                    <Button x:Name="PowerOffBtn" Content="Power off headphones" HorizontalAlignment="Stretch"
                            Margin="0,14,0,0" Foreground="#FFFF7B6B" Click="PowerOffBtn_Click"/>
                </StackPanel>

                <!-- Log -->
                <TextBlock Text="LOG" FontSize="13" Foreground="#FF5B8CFF" Margin="0,26,0,6"/>
                <Border BorderBrush="#FF3A3A3A" BorderThickness="1" Padding="8">
                    <TextBlock x:Name="LogText" Text="" FontSize="11" Foreground="#FFBFBFBF" TextWrapping="Wrap"/>
                </Border>
                <TextBlock Text="Unofficial app for your own headphones. Built on our xm4mini protocol code (from the open SonyHeadphonesClient research). Not made by Sony."
                           FontSize="11" Foreground="#FF777777" TextWrapping="Wrap" Margin="0,14,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
